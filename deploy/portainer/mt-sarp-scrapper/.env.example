# Exact Go image used to build and run the service.
SARP_GO_IMAGE=golang:1.26.5-bookworm

# Branch, tag, or full commit SHA to deploy. Prefer the delivered full SHA in
# production; the feature branch is useful for the first validation deploy.
SARP_REPOSITORY_URL=https://github.com/niflaot/sarp-scrapper.git
SARP_GIT_REF=agent/flaresolverr-integration

# SARP credential. Fill it only in Portainer; never commit the real value.
API_TOKEN=

# FlareSolverr is reached through the public Caddy endpoint as requested.
SARP_FLARESOLVERR_URL=https://flare.niflaot.dev/v1
SARP_FLARESOLVERR_TIMEOUT=90s

SARP_API_BASE_URL=https://api.sarp.es/api
SARP_API_TIMEOUT=30s
SARP_API_USER_AGENT=sarp-scrapper/1.0
SARP_SCRAPE_INTERVAL=30m
SARP_SCRAPE_JITTER=5m
LOG_LEVEL=info

# Minimum sale values included in the API, panel and Discord notifications.
LISTINGS_HOUSE_MIN_VALUE=500000
LISTINGS_BUSINESS_MIN_VALUE=100000

# Discord incoming webhook. Keep the real URL only in Portainer.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT=10s
DISCORD_WEBHOOK_USERNAME=SARP Scrapper
