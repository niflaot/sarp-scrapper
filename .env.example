# API first; visible Chrome login is the automatic fallback.
SARP_SCRAPER_ENABLED=true
API_TOKEN=
# FlareSolverr API endpoint exposed through Caddy. Keep empty to disable it.
SARP_FLARESOLVERR_URL=https://flare.niflaot.dev/v1
SARP_FLARESOLVERR_TIMEOUT=90s
SARP_EMAIL=
SARP_PASSWORD=

# Conservative polling: one run every 30 minutes with +/- 5 minutes of jitter.
SARP_SCRAPE_INTERVAL=30m
SARP_SCRAPE_JITTER=5m

# Persistent review cache and optional Discord notifications.
LISTINGS_STATE_FILE=.cache/listings-state.json
LISTINGS_HOUSE_MIN_VALUE=500000
LISTINGS_BUSINESS_MIN_VALUE=100000
LISTINGS_WAREHOUSE_MIN_VALUE=100000
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TIMEOUT=10s
DISCORD_WEBHOOK_USERNAME=SARP Scrapper

# Connection alerts for watched characters (disabled while the list is empty).
# DMs need DISCORD_BOT_TOKEN; the webhook above is used for a channel mention.
DISCORD_BOT_TOKEN=
PRESENCE_WATCH_NAMES=
PRESENCE_DISCORD_USER_ID=
PRESENCE_POLL_INTERVAL=60s
